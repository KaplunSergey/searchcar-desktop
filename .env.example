POSTGRES_DB=encar
POSTGRES_USER=encar
POSTGRES_PASSWORD=encar
DATABASE_URL=postgresql+psycopg://encar:encar@db:5432/encar
STORAGE_ROOT=/storage
PLAYWRIGHT_HEADLESS=true
WORKER_POLL_SECONDS=2
AUTH_COOKIE_NAME=encar_session
AUTH_CSRF_COOKIE_NAME=encar_csrf
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
# Replace with a long random value before exposing the app outside localhost.
AUTH_HASH_SECRET=replace-with-a-random-secret
REGISTRATION_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Absolute path to the existing monitor directory containing searches.json and data/.
LEGACY_DATA_DIR=/absolute/path/to/encar-monitor
NEXT_PUBLIC_API_URL=http://localhost:8000/api
