{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SearchCar Desktop",
  "version": "0.1.0",
  "identifier": "com.searchcar.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir .. desktop:frontend:dev",
    "beforeBuildCommand": "pnpm --dir .. desktop:frontend:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/searchcar-core"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../dist/": "desktop-ui/",
      "../runtime/browsers/": "browsers/",
      "../runtime/playwright-driver/": "playwright-driver/",
      "../license-service.json": "license-service.json"
    }
  }
}
