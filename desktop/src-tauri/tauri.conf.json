{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SearchCar Desktop",
  "version": "0.1.1",
  "identifier": "com.searchcar.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir .. desktop:frontend:dev",
    "beforeBuildCommand": "pnpm --dir .. desktop:frontend:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/searchcar-core"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../dist/": "desktop-ui/",
      "../runtime/browsers/": "browsers/",
      "../runtime/playwright-driver/": "playwright-driver/",
      "../license-service.json": "license-service.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyOTNGRDE0OTIyMDBCMgpSV1N5QUNKSjBUOHBDQ25YRlhld0VXY1ExVGk5K3gyMlZURURGaGhKRk4vbnpPVktMWnE1b0szdAo=",
      "endpoints": [
        "https://github.com/KaplunSergey/searchcar-desktop-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
