{
  "name": "searchcar-desktop",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run_with_wrangler_log.mjs vinext dev",
    "build": "node scripts/run_with_wrangler_log.mjs vinext build",
    "start": "node scripts/run_with_wrangler_log.mjs vinext start",
    "test": "node --test tests/*.test.mjs",
    "version:check": "node scripts/sync_app_version.mjs",
    "version:sync": "node scripts/sync_app_version.mjs --write",
    "release:updater-manifest": "node scripts/generate_tauri_updater_manifest.mjs",
    "sbom:generate": "node scripts/generate_sbom.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/dist --ignore-pattern desktop/runtime --ignore-pattern desktop/src-tauri/target --ignore-pattern work",
    "db:generate": "drizzle-kit generate",
    "license:typecheck": "tsc -p license-service/tsconfig.json",
    "license:build": "node scripts/run_with_wrangler_log.mjs wrangler deploy --dry-run --config license-service/wrangler.jsonc --outdir dist",
    "license:test": "pnpm license:build && node --test license-service/tests/*.test.mjs",
    "license:migrate:local": "wrangler d1 migrations apply LICENSE_DB --local --config license-service/wrangler.jsonc",
    "desktop:frontend:dev": "vite --config desktop/frontend/vite.config.ts",
    "desktop:frontend:build": "vite build --config desktop/frontend/vite.config.ts",
    "desktop:tauri:info": "cd desktop/src-tauri && tauri info",
    "desktop:tauri:dev": "cd desktop/src-tauri && tauri dev",
    "desktop:tauri:build": "cd desktop/src-tauri && tauri build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.83.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
