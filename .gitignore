# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.desktop-build-venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
__pycache__/
*.pyc

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/desktop/dist/
/.wrangler/
/license-service/.wrangler/
/license-service/dist/
/outputs/
/work/
/storage/
/legacy-data/

# desktop build output and local runtime state
**/src-tauri/target/
/desktop/src-tauri/gen/schemas/
/desktop/src-tauri/binaries/searchcar-core-*
/desktop/runtime/browsers/*
!/desktop/runtime/browsers/.gitkeep
/desktop/runtime/playwright-driver/*
!/desktop/runtime/playwright-driver/.gitkeep
/artifacts/
/desktop-dist/
*.build/
*.dist/
*.onefile-build/
nuitka-*-report.xml
.playwright/
ms-playwright/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.searchcar-backup

# Cloudflare local secrets and signing material
.searchcar-release-secrets/
.dev.vars
.dev.vars.*
*.key
*.p12
*.pfx
*.mobileprovision
tauri-signing-private-key*
license-signing-private-key*
