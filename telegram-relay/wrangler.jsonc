{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "searchcar-telegram-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PAIRING_ENABLED": "0", "CHAT_PAIRING_ENABLED": "0", "DELIVERY_ENABLED": "0", "BOT_ID": "0" },
  "secrets": { "required": ["TELEGRAM_WEBHOOK_SECRET", "TELEGRAM_BOT_TOKEN"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": false } },
  "d1_databases": [
    {
      "binding": "PAIRING_DB",
      "database_name": "searchcar-telegram-pairing",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "services": [{ "binding": "LICENSE_AUTH", "service": "searchcar-license-service", "entrypoint": "TelegramAuthorization" }],
  "env": {
    "staging": {
      "name": "searchcar-telegram-relay-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "PAIRING_ENABLED": "1", "CHAT_PAIRING_ENABLED": "1", "DELIVERY_ENABLED": "1", "BOT_ID": "8996925581" },
      "secrets": { "required": ["TELEGRAM_WEBHOOK_SECRET", "TELEGRAM_BOT_TOKEN"] },
      "services": [{ "binding": "LICENSE_AUTH", "service": "searchcar-license-service", "entrypoint": "TelegramAuthorization" }],
      "d1_databases": [
        {
          "binding": "PAIRING_DB",
          "database_name": "searchcar-telegram-pairing-staging",
          "database_id": "af51b56f-518a-45d3-ab85-a515c8e398ec",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
