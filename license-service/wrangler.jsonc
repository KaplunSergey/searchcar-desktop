{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "searchcar-license-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "LICENSE_SIGNING_PRIVATE_KEY",
      "CODE_PEPPER",
      "RATE_LIMIT_PEPPER",
      "ADMIN_API_TOKEN",
      "OWNER_PASSWORD_PEPPER"
    ]
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "LICENSE_SIGNING_KEY_ID": "searchcar-license-v1",
    "LICENSE_SIGNING_PUBLIC_KEY": "yuEaFu6U3l53W4umYMqu3wj_-uLcvEQpS-U4lq8eqyI",
    "LEASE_HOURS": "48",
    "TRIAL_DAYS": "30",
    "PUBLIC_RATE_LIMIT_PER_MINUTE": "30",
    "TRIAL_RATE_LIMIT_PER_HOUR": "5"
  },
  "d1_databases": [
    {
      "binding": "LICENSE_DB",
      "database_name": "searchcar-license-production",
      "database_id": "ac9fbe58-25de-48e0-950c-8abbfb92d486",
      "migrations_dir": "migrations"
    }
  ]
}
